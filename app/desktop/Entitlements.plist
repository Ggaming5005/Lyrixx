<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundle is signed with the hardened runtime, which refuses Apple
       Events (without even asking the user) unless the app holds this
       entitlement. Lyrix needs them: AppleScript (osascript, started by
       Lyrix) asks Spotify and Music what they play. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
